---
import type { ButtonProps } from '../types'

interface Props extends ButtonProps {}

const { href, variant = 'ghost', class: className, ...rest } = Astro.props

const variants = {
  primary:
    'bg-primary text-on-primary hover:bg-primary-soft border-transparent',
  ghost:
    'border-hairline hover:bg-canvas-soft text-mute hover:text-primary border',
}
---

<a
  href={href}
  class:list={[
    'tracking-eyebrow inline-flex items-center justify-center rounded-md px-4 py-2 font-mono text-[10px] uppercase transition-colors',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
