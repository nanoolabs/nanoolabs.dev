---
import type { ButtonProps } from '../types'

interface Props extends ButtonProps {}

const {
  href,
  variant = 'ghost',
  as: Tag = 'a',
  class: className,
  ...rest
} = Astro.props

const variants = {
  primary:
    'bg-primary text-on-primary hover:bg-primary-soft border-transparent',
  ghost:
    'border-hairline hover:bg-canvas-soft text-mute hover:text-primary border',
}
---

<Tag
  href={href}
  class:list={[
    'tracking-eyebrow inline-flex items-center justify-center px-4 py-2 font-mono text-[10px] uppercase transition-all duration-300',
    !className?.includes('rounded-') && 'rounded-md',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
