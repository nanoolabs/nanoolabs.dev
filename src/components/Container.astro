---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  narrow?: boolean
}

const { narrow = false, class: className, ...rest } = Astro.props
---

<div
  class:list={[
    'mx-auto w-full px-6 md:px-8',
    narrow ? 'max-w-3xl' : 'max-w-5xl',
    className,
  ]}
  {...rest}
>
  <slot />
</div>
