---
import type { BaseProps } from '../types'

interface Props extends BaseProps {
  size?: 'md' | 'lg'
}

const { size = 'lg', class: className, ...rest } = Astro.props

const sizes = {
  md: 'max-w-3xl',
  lg: 'max-w-5xl',
}
---

<div
  class:list={['mx-auto w-full px-6 md:px-8', sizes[size], className]}
  {...rest}
>
  <slot />
</div>
