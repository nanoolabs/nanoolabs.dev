---
import { FOOTER_COPYRIGHT } from '../consts'
import type { FooterProps } from '../types'
import RingNav from './RingNav.astro'

interface Props extends FooterProps {}

const { class: className, ...rest } = Astro.props
---

<footer
  class:list={['mt-32 flex flex-col items-center gap-8 py-12', className]}
  {...rest}
>
  <RingNav />

  <div
    class="text-mute tracking-eyebrow font-mono text-[9px] uppercase opacity-50"
  >
    {FOOTER_COPYRIGHT}
  </div>
</footer>
