---
import type { CardProps } from '../types'

interface Props extends CardProps {}

const { title, eyebrow, class: className, ...rest } = Astro.props
---

<div
  class:list={[
    'border-hairline bg-canvas-soft rounded-md border p-6',
    className,
  ]}
  {...rest}
>
  {
    eyebrow && (
      <h2 class="text-primary tracking-eyebrow mb-2 font-mono text-[10px] uppercase">
        {eyebrow}
      </h2>
    )
  }
  {
    title && (
      <h3 class="text-ink-strong mb-2 font-sans text-lg font-bold">{title}</h3>
    )
  }
  <div class="text-body text-sm">
    <slot />
  </div>
</div>
