---
import BaseLayout from '../layouts/BaseLayout.astro'
import Container from '../components/Container.astro'
import Card from '../components/Card.astro'
import Button from '../components/Button.astro'
import Footer from '../components/Footer.astro'
import { BRAND_TAGLINE } from '../consts'
---

<BaseLayout class="flex flex-col items-center justify-center p-8 text-center">
  <Container class="flex flex-col items-center">
    <main class="w-full">
      <h1
        class="text-primary mb-4 font-sans text-5xl font-bold tracking-tight md:text-6xl"
      >
        nanoo
      </h1>

      <blockquote
        class="text-mute tracking-eyebrow mb-12 font-mono text-xs uppercase italic md:text-sm"
      >
        "{BRAND_TAGLINE}"
      </blockquote>

      <div class="grid gap-4 text-left">
        <Card eyebrow="The Mission">
          <p>
            Nanoo is a development lab for the edge ecosystem. Experiment with
            Cloud, Edge, and Business logic to build simple and effective
            solutions.
          </p>
        </Card>

        <nav class="flex flex-wrap justify-center gap-3">
          <Button href="https://docs.nanoolabs.dev"> Read Docs </Button>
          <Button href="https://github.com/nanoolabs"> GitHub </Button>
        </nav>
      </div>
    </main>

    <Footer />
  </Container>
</BaseLayout>
