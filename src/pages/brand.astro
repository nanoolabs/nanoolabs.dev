---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { BRAND } from "@consts";
import { ICONS } from "@lib/icons";

const LOGO = [
  {
    label: "Standard Theme",
    bgClass: "bg-brand-base-light dark:bg-brand-base-dark",
    borderClass: "border-brand-neutral-light dark:border-brand-neutral-dark",
  },
];

const PHILOSOPHY = [
  {
    title: "Fast",
    description: "-",
  },
  {
    title: "Simple",
    description: "-",
  },
  {
    title: "Scalable",
    description: "-",
  },
];

const TYPOGRAPHY = [
  {
    name: "Geist Sans",
    usage: "Primary & Heading",
    class: "font-sans font-bold tracking-tight",
  },
  {
    name: "Geist Mono",
    usage: "Technical Data & Code",
    class: "font-mono tracking-tighter",
  },
];

const COLOR = [
  {
    name: "Base",
    value: "#050505 / #FFFFFF",
    bgClass: "bg-brand-base-dark dark:bg-brand-base-light",
  },
  {
    name: "Neutral",
    value: "Gray Series",
    bgClass: "bg-brand-neutral-light dark:bg-brand-neutral-dark",
  },
  {
    name: "Accent",
    value: "Cyan (#00ffff)",
    bgClass: "bg-brand-cyan",
  },
];
---

<Layout title={BRAND.TITLE} description={BRAND.DESCRIPTION}>
  <Container>
    <div class="space-y-16 sm:space-y-24">
      <section class="animate py-8">
        <h1 class="text-3xl font-semibold text-black dark:text-white">
          Brand Identity
        </h1>
        <p class="mt-4 text-lg text-gray-600 dark:text-white/70">
          The visual identity of Nanoo. Design to be simple, precise, and high
          performance.
        </p>
      </section>

      <!-- Logo Section -->
      <section class="animate space-y-8">
        <div class="flex flex-col gap-y-2">
          <h2 class="text-xl font-semibold text-black dark:text-white">
            Logomark
          </h2>
          <p class="text-sm text-gray-500 dark:text-white/50">
            Our main logo, based on the Geist typeface.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4">
          {
            LOGO.map((variant) => (
              <div
                class={`flex flex-col items-center justify-center rounded-xl border p-12 ${variant.bgClass} ${variant.borderClass}`}
              >
                <div class="size-32 text-black dark:text-white">
                  <Fragment set:html={ICONS.LOGO} />
                </div>
                <p class="mt-8 font-mono text-xs tracking-widest text-gray-400 uppercase">
                  {variant.label}
                </p>
              </div>
            ))
          }
        </div>

        <article class="prose dark:prose-invert">
          <p>
            The Nanoo logomark is a simple version of the lowercase letter "n".
            It utilizes the <strong>Geist</strong> fonts precision to represent focus
            on fundamental engineering and clean logic. The sharp arch represent easy
            connectivity and efficient architecture.
          </p>
        </article>
      </section>

      <!-- Philosophy Section -->
      <section class="animate space-y-8">
        <div class="flex flex-col gap-y-2">
          <h2 class="text-xl font-semibold text-black dark:text-white">
            Philosophy
          </h2>
          <p class="text-sm text-gray-500 dark:text-white/50">
            The three pillars of Nanoo
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {
            PHILOSOPHY.map((item) => (
              <div class="border-brand-neutral-light dark:border-brand-neutral-dark dark:bg-brand-base-dark/50 rounded-xl border bg-gray-50/50 p-6">
                <h3 class="font-semibold text-black dark:text-white">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm text-gray-600 dark:text-white/70">
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Typography Section -->
      <section class="animate space-y-8">
        <div class="flex flex-col gap-y-2">
          <h2 class="text-xl font-semibold text-black dark:text-white">
            Typography
          </h2>
          <p class="text-sm text-gray-500 dark:text-white/50">
            Modern fonts for a technical audience.
          </p>
        </div>

        <div class="space-y-4">
          {
            TYPOGRAPHY.map((font) => (
              <div class="border-brand-neutral-light dark:border-brand-neutral-dark dark:bg-brand-base-dark/50 rounded-xl border bg-gray-50/50 p-8">
                <p class={`text-5xl ${font.class}`}>{font.name}</p>
                <p class="mt-4 font-mono text-sm tracking-wider text-gray-500 uppercase">
                  {font.usage}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Colors Section -->
      <section class="animate space-y-8">
        <div class="flex flex-col gap-y-2">
          <h2 class="text-xl font-semibold text-black dark:text-white">
            Color Palette
          </h2>
          <p class="text-sm text-gray-500 dark:text-white/50">
            A neutral base with a high contrast accent color.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {
            COLOR.map((color) => (
              <div class="space-y-3">
                <div
                  class={`h-32 rounded-xl border border-black/10 ${color.bgClass}`}
                />
                <div>
                  <p class="text-sm font-semibold">{color.name}</p>
                  <p class="font-mono text-xs text-gray-500">{color.value}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Assets Section -->
      <section class="animate space-y-6">
        <h2 class="text-xl font-semibold text-black dark:text-white">
          Digital Assets
        </h2>
        <div class="flex flex-wrap gap-4">
          <a
            href="/favicon.svg"
            download
            class="bg-brand-neutral-light dark:bg-brand-base-dark flex items-center gap-2 rounded-sm border border-black/15 px-4 py-2 text-sm transition-all duration-300 hover:bg-black/5 dark:border-white/25 dark:hover:bg-white/5"
          >
            <div class="size-4">
              <Fragment set:html={ICONS.LOGO} />
            </div>
            Download SVG Logo
          </a>
        </div>
      </section>
    </div>
  </Container>
</Layout>
